[Unit]
Description=Gunicorn & Uvicorn Service for MeterReadAI Backend
After=network.target

[Service]
# User sở hữu code trên server (ví dụ: ubuntu)
User=ubuntu
# Group www-data giúp Nginx có quyền đọc/ghi file gunicorn.sock
Group=www-data

# Thư mục chứa code backend
WorkingDirectory=/home/ubuntu/MeterReadAI/backend

# Nếu có file .env chứa SECRET_KEY, DATABASE_URL, bỏ comment dòng dưới:
# EnvironmentFile=/home/ubuntu/MeterReadAI/backend/.env

# Lệnh khởi chạy: trỏ thẳng vào binary gunicorn trong venv
ExecStart=/home/ubuntu/MeterReadAI/venv/bin/gunicorn -c /home/ubuntu/MeterReadAI/backend/gunicorn_conf.py app.main:app

# Tự động khởi động lại nếu app gặp lỗi crash
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

